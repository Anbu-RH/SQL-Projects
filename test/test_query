                CREATE DATABASE
🏗========================================================🏗
*/

CREATE DATABASE baraa_bronze;

USE baraa_bronze;



/*
📋========================================================📋
                VIEW SOURCE TABLES
📋========================================================📋
*/

SELECT * FROM crm_cust_info;

SELECT * FROM crm_prd_info;

SELECT * FROM crm_sales_details;

SELECT * FROM erp_cust;

SELECT * FROM erp_loc;

SELECT * FROM erp_cat;



/*
🧹========================================================🧹
            CRM CUSTOMER DATA VALIDATION
🧹========================================================🧹
*/

-- Check NULLs and Duplicates

SELECT
    cst_id,
    COUNT(*)

FROM crm_cust_info

GROUP BY cst_id

HAVING COUNT(*) > 1
    OR cst_id IS NULL
    OR cst_id = '';



-- Check Unwanted Spaces

SELECT
    cst_firstname,
    cst_lastname

FROM crm_cust_info

WHERE cst_firstname <> TRIM(cst_firstname)
   OR cst_lastname <> TRIM(cst_lastname);



-- Check Empty Values

SELECT
    cst_firstname,
    cst_lastname

FROM crm_cust_info

WHERE cst_firstname = ''
   OR cst_lastname = '';



-- Convert Empty Values into NULL

UPDATE crm_cust_info
SET cst_firstname = NULL
WHERE cst_firstname = '';



UPDATE crm_cust_info
SET cst_lastname = NULL
WHERE cst_lastname = '';



-- Check Distinct Gender Values

SELECT DISTINCT cst_gender
FROM crm_cust_info;



-- Replace Empty Gender Values

UPDATE crm_cust_info
SET cst_gender = NULL
WHERE cst_gender = '';



-- Drop Unwanted Column

ALTER TABLE crm_cust_info
DROP COLUMN crm_cust_infocol;



-- Normalize Gender and Marital Status

SELECT *,

    CASE
        WHEN UPPER(cst_gender) = 'F'
            THEN 'Female'

        WHEN UPPER(cst_gender) = 'M'
            THEN 'Male'

        ELSE 'n/a'
    END AS cst_gender_cleaned,



    CASE
        WHEN UPPER(cst_marital_status) = 'M'
            THEN 'Married'

        WHEN UPPER(cst_marital_status) = 'S'
            THEN 'Single'

        ELSE 'n/a'
    END AS cst_marital_status_cleaned

FROM crm_cust_info;



-- Identify Duplicate Records

SELECT *,

       ROW_NUMBER() OVER (
           PARTITION BY cst_id
           ORDER BY cst_create_date
       ) AS flag

FROM crm_cust_info;



/*
🚴========================================================🚴
            CRM PRODUCT DATA VALIDATION
🚴========================================================🚴
*/

-- Check NULLs and Duplicates

SELECT
    prd_id,
    COUNT(*)

FROM crm_prd_info

GROUP BY prd_id

HAVING COUNT(*) > 1
    OR prd_id IS NULL
    OR prd_id = '';



-- Check Unwanted Spaces

SELECT
    prd_nm

FROM crm_prd_info

WHERE prd_nm <> TRIM(prd_nm);



-- Check Empty Product Names

SELECT
    prd_nm

FROM crm_prd_info

WHERE prd_nm = '';



-- Split Product Key

SELECT

    prd_key,

    REPLACE(
        SUBSTRING(prd_key,1,5),
        '-',
        '_'
    ) AS cat_id,

    SUBSTRING(prd_key,7,13) AS prd_key_new

FROM crm_prd_info;



-- Handle Missing Product Cost

UPDATE crm_prd_info
SET prd_cost = NULL
WHERE prd_cost = '';



SELECT
    prd_cost

FROM crm_prd_info

WHERE prd_cost IS NULL;



UPDATE crm_prd_info
SET prd_cost = 0
WHERE prd_cost IS NULL;



-- Normalize Product Line

SELECT *,

    CASE
        WHEN UPPER(TRIM(prd_line)) = 'M'
            THEN 'Mountain'

        WHEN UPPER(TRIM(prd_line)) = 'R'
            THEN 'Road'

        WHEN UPPER(TRIM(prd_line)) = 'S'
            THEN 'Other Sales'

        WHEN UPPER(TRIM(prd_line)) = 'T'
            THEN 'Touring'

        ELSE 'n/a'
    END AS prd_line_cleaned

FROM crm_prd_info;



-- Create Product End Date

SELECT *,

       DATE_SUB(

           LEAD(prd_start_dt)
           OVER (
               PARTITION BY prd_key
               ORDER BY prd_start_dt
           ),

           INTERVAL 1 DAY

       ) AS prd_end_date_new

FROM crm_prd_info;



/*
💰========================================================💰
            CRM SALES DATA VALIDATION
💰========================================================💰
*/

-- Validate Order Date Format

SELECT *,

       CASE
           WHEN sls_order_dt = 0
                OR CHAR_LENGTH(sls_order_dt) != 8
           THEN NULL

           ELSE STR_TO_DATE(
               sls_order_dt,
               '%Y%m%d'
           )
       END AS sls_order_dt_new

FROM crm_sales_details;



-- Detect Invalid Dates

SELECT
    sls_order_dt

FROM crm_sales_details

WHERE sls_order_dt IS NULL
   OR sls_order_dt = ''
   OR sls_order_dt = 0
   OR CHAR_LENGTH(sls_order_dt) != 8;



-- Validate Sales Logic

SELECT *

FROM crm_sales_details

WHERE sls_sales != sls_quantity * sls_price
   OR sls_sales IS NULL
   OR sls_quantity IS NULL
   OR sls_price IS NULL
   OR sls_sales <= 0
   OR sls_quantity <= 0
   OR sls_price <= 0;



-- Correct Invalid Sales and Price

SELECT *,

    CASE
        WHEN sls_sales IS NULL
             OR sls_sales <= 0
             OR sls_sales != sls_quantity * ABS(sls_price)

        THEN sls_quantity * ABS(sls_price)

        ELSE sls_sales
    END AS new_sales,



    CASE
        WHEN sls_price IS NULL
             OR sls_price <= 0

        THEN sls_sales / NULLIF(sls_quantity,0)

        ELSE sls_price
    END AS new_price

FROM crm_sales_details;



/*
🧑========================================================🧑
            ERP CUSTOMER VALIDATION
🧑========================================================🧑
*/

UPDATE erp_cust

SET

    cid = CASE
              WHEN cid LIKE 'NAS%'
              THEN SUBSTRING(cid,4)

              ELSE cid
          END,



    bdate = CASE
                WHEN bdate > CURDATE()
                THEN NULL

                ELSE bdate
            END,



    gen = CASE
              WHEN UPPER(TRIM(gen)) IN ('F','FEMALE')
              THEN 'Female'

              WHEN UPPER(TRIM(gen)) IN ('M','MALE')
              THEN 'Male'

              ELSE 'n/a'
          END;



/*
🌍========================================================🌍
            ERP LOCATION VALIDATION
🌍========================================================🌍
*/

UPDATE erp_loc

SET

    cid = REPLACE(cid,'-',''),



    cntry = CASE

                WHEN TRIM(cntry) = 'DE'
                THEN 'Germany'

                WHEN TRIM(cntry) IN ('US','USA')
                THEN 'United States'

                WHEN TRIM(cntry) = ''
                     OR cntry IS NULL
                THEN 'n/a'

                ELSE TRIM(cntry)

            END;



/*
🛠========================================================🛠
            ERP CATEGORY VALIDATION
🛠========================================================🛠
*/

UPDATE erp_cat

SET

    id = TRIM(id),

    cat = TRIM(cat),

    subcat = TRIM(subcat),

    maintenance = TRIM(maintenance);



